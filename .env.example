# Public site — values here are inlined into the browser at build time.
# Never put DATABASE_URL, JWT, SMTP, or AWS keys in this file.

# Required: ECS backend (ALB today, custom API domain after HTTPS)
NEXT_PUBLIC_BASE_API_URL=https://api.zrf.info/api/v1
# Optional alias — getPublicApiUrl() reads this if BASE_API_URL is empty
NEXT_PUBLIC_API_URL=https://api.zrf.info/api/v1

NEXT_PUBLIC_SITE_URL=https://zrf.info
NEXT_PUBLIC_SITE_NAME=zrf
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
NEXT_PUBLIC_CHAT_ID=
